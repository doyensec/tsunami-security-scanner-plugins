# proto-file: proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "MinIO_CVE_2023_28432"
  author: 
    "Robert Dick (robert@doyensec.com) for the templated version, "
    "Hans-Martin Münch (muench@mogwailabs.de) for the original Java version"
  version: "2.0"
}

finding: {
  main_id: {
    publisher: "TSUNAMI_COMMUNITY"
    value: "CVE_2023_28432"
  }
  severity: CRITICAL
  title: "MinIO Environment Variable Information Disclosure (CVE-2023-28432)"
  description: 
    "Due to a vulnerability in an API endpoint, MinIO returns all environment variables,"
    " including MINIO_SECRET_KEY and MINIO_ROOT_PASSWORD, resulting in information"
    " disclosure."
  recommendation: 
    "Update to the latest MinIO version (>= RELEASE.2023-03-20T20-16-18Z)."
    " The MINIO_SECRET_KEY and / or MINIO_ROOT_PASSWORD of the affected MinIO instance must"
    " be changed."
  related_id: {
    publisher: "CVE"
    value: "CVE-2023-28432"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_minio"
  http_request: {
    method: GET
    uri: "/"
    response: {
      expect_any: {
        conditions: [
          { header: { name: "Server" } contains: "MinIO" },
          { header: { name: "Server" } contains: "Minio" },
          { header: { name: "Server" } contains: "minio" }
        ]
      }
    }
  }
}


actions: {
  name: "check_environment"
  http_request: {
    method: POST
    uri: "/minio/bootstrap/v1/verify"
    response: {
      expect_any: {
        conditions: [
          { body: {} contains: '"MINIO_ROOT_PASSWORD":' },
          { body: {} contains: '"MINIO_SECRET_KEY":' }
        ]
      }
    }
  }
}


#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "fingerprint_minio",
    "check_environment"
  ]
}

