# proto-file: proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

config: {
  tested_plugin: "Metabase_CVE_2023_37470"
}

tests: {
  name: "whenVulnerable_returnsTrue"
  expect_vulnerability: true

  mock_callback_server: {
    enabled: true
    has_interaction: true
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: "... <title>Metabase</title> ..."
      },
      {
        uri: "/api/session/properties"
        status: 200
        body_content: 
          "... ,\"setup-token\":\"00000000-0000-0000-0000-000000000000\", ..."
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: 
          "{}"
      }
    ]
  }
}

tests: {
  name: "whenNoSetupToken_returnsFalse"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: true
    has_interaction: false
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: "... <title>Metabase</title> ..."
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: 
          "{}"
      }
    ]
  }
}


tests: {
  name: "whenNoCallback_returnsFalse"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: true
    has_interaction: false
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: "... <title>Metabase</title> ..."
      },
      {
        uri: "/api/session/properties"
        status: 200
        body_content: 
          "... ,\"setup-token\":\"493b308e-58c8-4d6d-b26d-55004fd0ffb6\", ..."
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: 
          "{}"
      }
    ]
  }
}


tests: {
  name: "whenRandomServer_returnsFalse"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: true
    has_interaction: false
  }

  mock_http_server: {
    mock_responses: [
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "{}"
      }
    ]
  }
}



