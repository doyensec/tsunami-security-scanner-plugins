# proto-file: proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

config: {
  tested_plugin: "ArgoCD_ExposedUI"
}

tests: {
  name: "whenVulnerableOOB_returnsVuln"
  expect_vulnerability: true

  mock_callback_server: {
    enabled: true
    has_interaction: true
  }
  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: '... <title>Argo CD</title> ...'
      },
      {
        uri: "/api/v1/projects?fields=items.metadata.name"
        status: 200
        body_content: '{"items":[{"metadata":{"name":"default"}}]}'
      },
      {
        uri: "/api/v1/clusters"
        status: 200
        body_content: 
          '{"metadata":{},"items":[{"server":"https://kubernetes.default.svc"'
          ',"name":"in-cluster","config":{"tlsClientConfig":{"insecure":false'
          '}},"connectionState":{"status":"Unknown","message":"Cluster has no'
          ' applications and is not being monitored.","attemptedAt":"2026-11-'
          '12T15:00:29Z"},"serverVersion":"1.37.0","info":{"connectionState":'
          '{"status":"Unknown","message":"Cluster has no applications and is '
          'not being monitored.","attemptedAt":"2026-11-12T15:00:29Z"},"serve'
          'rVersion":"1.37.0","cacheInfo":{},"applicationsCount":0},"configHa'
          'sh":734506163208423476}]}'
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "{ ... }"
      }
    ]
  }
}

tests: {
  name: "whenNotVulnerableOOB_returnsNotVuln"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: true
    has_interaction: false
  }
  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: '... <title>Argo CD</title> ...'
      },
      {
        uri: "/api/v1/projects?fields=items.metadata.name"
        status: 200
        body_content: "{ ... \"name\":\"exampleprojectname\", ... }"
      },
      {
        uri: "/api/v1/clusters"
        status: 200
        body_content: "{ ... \"name\":\"exampleclustername\", ... }"
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "{ ... }"
      }
    ]
  }
}


tests: {
  name: "whenVulnerableReflective_returnsVuln"
  expect_vulnerability: true

  mock_callback_server: {
    enabled: false
    has_interaction: false
  }
  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: '... <title>Argo CD</title> ...'
      },
      {
        uri: "/api/v1/projects?fields=items.metadata.name"
        status: 200
        body_content: '{"items":[{"metadata":{"name":"default"}}]}'
      },
      {
        uri: "/api/v1/clusters"
        status: 200
        body_content: 
          '{"metadata":{},"items":[{"server":"https://kubernetes.default.svc"'
          ',"name":"in-cluster","config":{"tlsClientConfig":{"insecure":false'
          '}},"connectionState":{"status":"Unknown","message":"Cluster has no'
          ' applications and is not being monitored.","attemptedAt":"2026-11-'
          '12T15:00:29Z"},"serverVersion":"1.37.0","info":{"connectionState":'
          '{"status":"Unknown","message":"Cluster has no applications and is '
          'not being monitored.","attemptedAt":"2026-11-12T15:00:29Z"},"serve'
          'rVersion":"1.37.0","cacheInfo":{},"applicationsCount":0},"configHa'
          'sh":734506163208423476}]}'
      },    
      {
        uri: "/api/v1/applications/tsunami-security-scanner-{{ T_UTL_CURRENT_TIMESTAMP_MS }}?appNamespace=argocd"
        status: 200
        body_content: 
          '... 133713371337 ...'
          '"images": ['
          '"curlimages/curl:7.78.0",'
          '"nginx:1.24"'
          '] ...'
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "{ ... }"
      }
    ]
  }
}

tests: {
  name: "whenNotVulnerableReflective_returnsNotVuln"
  expect_vulnerability: false

  mock_callback_server: {
    enabled: false
    has_interaction: false
  }
  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        body_content: '... <title>Argo CD</title> ...'
      },
      {
        uri: "/api/v1/projects?fields=items.metadata.name"
        status: 200
        body_content: "{ ... \"name\":\"exampleprojectname\", ... }"
      },
      {
        uri: "/api/v1/clusters"
        status: 200
        body_content: "{ ... \"name\":\"exampleclustername\", ... }"
      },
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "{ ... }"
      }
    ]
  }
}


tests: {
  name: "whenRandomServer_returnsNoVuln"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri:  "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: " ... "
      }
    ]
  }
}
