          '      "cloud":{'
          '        "collection":"configuredcore",'
          '        "shard":"shard1",'
          '        "replica":"core_node2",'
          '        "replicaType":"NRT"'
          '      },'
          '      "index":{'
          '        "numDocs":0,'
