tests: {
  name: "whenVulnerableReflective_returnsTrue"
  expect_vulnerability: true

  mock_http_server: {
    mock_responses: [
      {
        uri: "/solr/admin/info/system?wt=json"
        status: 200
        body_content: 
          '{'
          '  "responseHeader":{'
          '    "status":0,'
